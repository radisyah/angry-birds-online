# Diisi OTOMATIS oleh integrasi Upstash Redis di Vercel (salah satu pasangan nama ini).
# Hanya perlu diisi manual bila ingin menguji Redis sungguhan dari komputermu.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# atau nama lama dari Vercel KV:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- TURN (relay) agar video gameplay sampai ke Room Master di semua jaringan. Isi SALAH SATU: ---
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
